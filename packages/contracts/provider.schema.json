{
  "$defs": {
    "AgentRequestRecord": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Attempt Id",
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/ProviderIdentityRecord"
        },
        "policy_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Policy Version",
          "type": "string"
        },
        "prompt_path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Prompt Path",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Role",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Id",
          "type": "string"
        },
        "workspace": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "attempt_id",
        "role",
        "identity",
        "prompt_path",
        "workspace",
        "policy_version"
      ],
      "title": "AgentRequestRecord",
      "type": "object"
    },
    "ArtifactDependency": {
      "additionalProperties": false,
      "properties": {
        "artifact_version_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Artifact Version Id",
          "type": "string"
        },
        "relationship": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Relationship",
          "type": "string"
        }
      },
      "required": [
        "artifact_version_id",
        "relationship"
      ],
      "title": "ArtifactDependency",
      "type": "object"
    },
    "ArtifactPair": {
      "additionalProperties": false,
      "properties": {
        "artifact_pair_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Artifact Pair Id",
          "type": "string"
        },
        "chinese_artifact_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Chinese Artifact Id",
          "type": "string"
        },
        "english_artifact_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "English Artifact Id",
          "type": "string"
        },
        "format": {
          "enum": [
            "pdf",
            "docx",
            "markdown"
          ],
          "title": "Format",
          "type": "string"
        },
        "source_version_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Version Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_pair_id",
        "format",
        "source_version_id",
        "english_artifact_id",
        "chinese_artifact_id"
      ],
      "title": "ArtifactPair",
      "type": "object"
    },
    "ArtifactVersion": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "canonical_issued_by": {
                "const": "A"
              }
            }
          },
          "then": {
            "properties": {
              "a_response_ref": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "a_response_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "A Response Ref"
        },
        "artifact_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Artifact Kind",
          "type": "string"
        },
        "byte_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "title": "Byte Sha256",
          "type": "string"
        },
        "canonical_content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "title": "Canonical Content Sha256",
          "type": "string"
        },
        "canonical_issued_by": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Canonical Issued By",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/ArtifactDependency"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "immutable_uri": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Immutable Uri",
          "type": "string"
        },
        "language": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Language",
          "type": "string"
        },
        "origin_authors": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Origin Authors",
          "type": "array"
        },
        "rendered_by": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rendered By",
          "type": "string"
        },
        "reviewed_by": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Reviewed By",
          "type": "array"
        },
        "source_version_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Version Id"
        },
        "task_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "task_id",
        "artifact_kind",
        "language",
        "immutable_uri",
        "byte_sha256",
        "canonical_content_sha256",
        "source_version_id",
        "origin_authors",
        "canonical_issued_by",
        "reviewed_by",
        "rendered_by",
        "a_response_ref",
        "dependencies"
      ],
      "title": "ArtifactVersion",
      "type": "object"
    },
    "DeliveryBundle": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "PUBLISHED"
              }
            }
          },
          "then": {
            "properties": {
              "approval_id": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "published_at": {
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
                "type": "string"
              },
              "source_version_ids": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "description": "A stored state/reference declaration; the publisher must verify it.",
      "properties": {
        "approval_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approval Id"
        },
        "format_pairs": {
          "items": {
            "$ref": "#/$defs/ArtifactPair"
          },
          "title": "Format Pairs",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
        },
        "qa_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Qa Ids",
          "type": "array"
        },
        "route_snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Route Snapshot Id",
          "type": "string"
        },
        "source_version_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Source Version Ids",
          "type": "array"
        },
        "spec_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Spec Version",
          "type": "string"
        },
        "state": {
          "enum": [
            "STAGING",
            "VERIFIED",
            "PUBLISHED"
          ],
          "title": "State",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Id",
          "type": "string"
        },
        "translation_version_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Translation Version Ids",
          "type": "array"
        },
        "turn_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "task_id",
        "turn_id",
        "spec_version",
        "route_snapshot_id",
        "source_version_ids",
        "translation_version_ids",
        "format_pairs",
        "qa_ids",
        "approval_id",
        "state",
        "published_at"
      ],
      "title": "DeliveryBundle",
      "type": "object"
    },
    "IdentityStatus": {
      "enum": [
        "verified",
        "unknown",
        "mismatch"
      ],
      "title": "IdentityStatus",
      "type": "string"
    },
    "InternalEventRecord": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Attempt Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "task_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "attempt_id",
        "sequence",
        "kind",
        "payload"
      ],
      "title": "InternalEventRecord",
      "type": "object"
    },
    "MessageRecord": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "language": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Language",
          "type": "string"
        },
        "parent_message_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Message Id"
        },
        "raw_content_ref": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Raw Content Ref",
          "type": "string"
        },
        "route_snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Route Snapshot Id",
          "type": "string"
        },
        "source_role": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Role",
          "type": "string"
        },
        "turn_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Turn Id",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "user",
            "internal",
            "attachment"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "id",
        "turn_id",
        "source_role",
        "language",
        "raw_content_ref",
        "content_sha256",
        "parent_message_id",
        "route_snapshot_id",
        "visibility",
        "created_at"
      ],
      "title": "MessageRecord",
      "type": "object"
    },
    "ModelFamily": {
      "enum": [
        "claude",
        "gpt",
        "glm",
        "unknown"
      ],
      "title": "ModelFamily",
      "type": "string"
    },
    "ProviderIdentityRecord": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Adapter",
          "type": "string"
        },
        "connection_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Connection Id",
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/ModelFamily"
        },
        "model_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Model Id",
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "model_id",
        "family",
        "connection_id"
      ],
      "title": "ProviderIdentityRecord",
      "type": "object"
    },
    "RouteSnapshot": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "identity_status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "model_family": {
                      "const": "claude"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "route_policy": {
                      "const": "claude_en_bridge"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "model_family": {
                      "const": "gpt"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "route_policy": {
                      "const": "native"
                    }
                  }
                }
              }
            ],
            "properties": {
              "identity_source": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "model_family": {
                "enum": [
                  "claude",
                  "gpt"
                ]
              },
              "route_policy": {
                "enum": [
                  "claude_en_bridge",
                  "native"
                ]
              }
            }
          }
        }
      ],
      "description": "Unknown identity is recordable with explicit null policy, never executable.",
      "properties": {
        "adapter_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Adapter Id",
          "type": "string"
        },
        "attempt_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Attempt Id",
          "type": "string"
        },
        "connection_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Connection Version",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "identity_source": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Identity Source"
        },
        "identity_status": {
          "$ref": "#/$defs/IdentityStatus"
        },
        "locked_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
          "title": "Locked At",
          "type": "string"
        },
        "model_family": {
          "$ref": "#/$defs/ModelFamily"
        },
        "model_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Model Id",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Policy Version",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider Id",
          "type": "string"
        },
        "route_policy": {
          "anyOf": [
            {
              "enum": [
                "claude_en_bridge",
                "native"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Route Policy"
        },
        "task_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Id",
          "type": "string"
        },
        "turn_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "task_id",
        "turn_id",
        "attempt_id",
        "provider_id",
        "model_id",
        "model_family",
        "adapter_id",
        "identity_status",
        "identity_source",
        "connection_version",
        "policy_version",
        "route_policy",
        "locked_at"
      ],
      "title": "RouteSnapshot",
      "type": "object"
    },
    "SemanticFinding": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Block Id",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "none",
            "minor",
            "major",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_locator": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Locator",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "code",
        "severity",
        "message",
        "source_locator"
      ],
      "title": "SemanticFinding",
      "type": "object"
    },
    "TranslationBlock": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "translation_status": {
                "const": "READY"
              }
            }
          },
          "then": {
            "properties": {
              "target_ref": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "target_sha256": {
                "maxLength": 64,
                "minLength": 64,
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "block_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Block Id",
          "type": "string"
        },
        "job_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Job Id",
          "type": "string"
        },
        "protected_span_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Protected Span Ids",
          "type": "array"
        },
        "source_locator": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Locator",
          "type": "string"
        },
        "source_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "target_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Ref"
        },
        "target_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Sha256"
        },
        "translation_status": {
          "enum": [
            "PENDING",
            "RUNNING",
            "QA",
            "READY",
            "REPAIRING",
            "NEEDS_INPUT",
            "FAILED",
            "CANCELLED",
            "STALE"
          ],
          "title": "Translation Status",
          "type": "string"
        },
        "uncertainty_codes": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Uncertainty Codes",
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "block_id",
        "source_locator",
        "source_sha256",
        "target_ref",
        "target_sha256",
        "protected_span_ids",
        "translation_status",
        "uncertainty_codes"
      ],
      "title": "TranslationBlock",
      "type": "object"
    },
    "TranslationJob": {
      "additionalProperties": false,
      "properties": {
        "attempt_count": {
          "maximum": 3,
          "minimum": 0,
          "title": "Attempt Count",
          "type": "integer"
        },
        "budget_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Budget Id",
          "type": "string"
        },
        "glossary_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Glossary Version",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "policy_version": {
