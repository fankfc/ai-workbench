{
  "name": "ai-workbench",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/desktop"
  ],
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "test:desktop": "vitest run tests/desktop",
    "build:desktop": "npm run build --workspace @ai-workbench/desktop",
    "build:desktop:test": "npm run build:test --workspace @ai-workbench/desktop",
    "typecheck:desktop": "npm run typecheck --workspace @ai-workbench/desktop",
    "desktop": "npm run start --workspace @ai-workbench/desktop",
    "desktop:demo": "npm run start:demo --workspace @ai-workbench/desktop",
    "test:e2e:real": "node tests/support/run-real-e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}