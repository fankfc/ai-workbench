{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "build",
    "scenario",
    "expected",
    "actual",
    "severity",
    "steps",
    "include_diagnostics",
    "content_opt_in"
  ],
  "properties": {
    "build": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "actual": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "include_diagnostics": {
      "type": "boolean",
      "default": false
    },
    "content_opt_in": {
      "type": "boolean",
      "const": false,
      "description": "Current exporter never attaches selected content. A future per-feedback human UI consent flow is required."
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
